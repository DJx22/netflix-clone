<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Catalog.Domain\Catalog.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- MediatR — chosen over a custom mediator for pipeline behaviour support (logging, validation) -->
    <PackageReference Include="MediatR"                                   Version="12.*" />
    <!-- FluentValidation — validates every command before it reaches a handler (§12) -->
    <PackageReference Include="FluentValidation"                          Version="11.10.0" />
    <!-- Logging abstractions — ILogger<T> for LoggingBehaviour; no full hosting stack needed in Application -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.*" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
