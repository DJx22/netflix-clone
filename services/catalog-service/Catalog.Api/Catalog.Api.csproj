<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- FluentValidation — auto-validates [FromBody] DTOs before actions run (§12) -->
    <PackageReference Include="FluentValidation.AspNetCore"                         Version="11.*" />
    <!-- JWT Bearer — validates issuer, audience, expiry on every authenticated request (§12) -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer"       Version="10.*" />
    <!-- OpenAPI / Swagger -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi"                        Version="10.0.11" />
    <PackageReference Include="Swashbuckle.AspNetCore"                              Version="10.*" />
    <!-- MongoDB readiness check — pings the database, not just process liveness (§11) -->
    <PackageReference Include="AspNetCore.HealthChecks.MongoDb"                     Version="9.*" />
    <!-- Structured logging — replaces the default Microsoft logger (§13) -->
    <PackageReference Include="Serilog.AspNetCore"                                  Version="9.*" />
    <PackageReference Include="Serilog.Enrichers.Environment"                       Version="3.*" />
    <PackageReference Include="Serilog.Sinks.Console"                               Version="6.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Catalog.Application\Catalog.Application.csproj" />
    <ProjectReference Include="..\Catalog.Infrastructure\Catalog.Infrastructure.csproj" />
  </ItemGroup>

</Project>
