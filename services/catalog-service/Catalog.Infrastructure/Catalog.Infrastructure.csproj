<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Catalog.Domain\Catalog.Domain.csproj" />
    <ProjectReference Include="..\Catalog.Application\Catalog.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- MongoDB driver — the only project in the solution permitted to reference this (ADR 0005, §2) -->
    <PackageReference Include="MongoDB.Driver"                            Version="3.*" />
    <!-- DI / Options / Logging infrastructure — kept in Abstractions packages to avoid pulling in ASP.NET hosting -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"  Version="9.*" />
    <PackageReference Include="Microsoft.Extensions.Options"                           Version="9.*" />
    <!-- ConfigurationExtensions required for services.Configure<T>(IConfigurationSection) overload -->
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions"   Version="9.*" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions"        Version="9.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"              Version="9.*" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
